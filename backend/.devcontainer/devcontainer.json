{
  "name": "Django Dev",
  // This is the standard Microsoft Python image for Dev Containers
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // Installs your dependencies after the container builds
  "postCreateCommand": "pip install -r requirements.txt",

  // Exposes port 8000 so you can access localhost:8000
  "forwardPorts": [8000],

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
